/*41)A conversão de graus Farenheit para Centígrados é obtida por C = (5-9)x(F-32). Fazer um
algoritmo que calcule e escreva uma tabela de centígrados em função de graus Farenheit, que
variam de 50 a 150 de 1 em 1.*/

#include<stdio.h>
int main(){
	int f;
	float c;
		printf("Tabela de conversao de Fahrenheit para Centigrados\n\n");
			for(f = 50; f <= 150; f++) {
	        	c = (5.0 / 9.0) * (f - 32);
			       printf("%d\t\t%.2f\n", f, c);
    }
}
